[Unit]
Description=Existing ZITAR hourly V3 paper reference cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zitar
Group=zitar
WorkingDirectory=/srv/zitar/runtime
ExecStartPre=/srv/zitar/venv/bin/python -m zitar_next.hosting check --base /srv/zitar/runtime --next-root /srv/zitar/data/next
ExecStart=/srv/zitar/venv/bin/python -B -m zitar_next.run_v3 --base /srv/zitar/runtime --next-root /srv/zitar/data/next
Environment=OMP_NUM_THREADS=1
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/zitar/runtime
MemoryMax=1G
CPUQuota=25%
