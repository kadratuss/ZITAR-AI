[Unit]
Description=ZITAR single dashboard entrance
After=zitar-production.service zitar-console.service
Wants=zitar-production.service zitar-console.service

[Service]
User=zitar
Group=zitar
WorkingDirectory=/srv/zitar/runtime
ExecStart=/srv/zitar/venv/bin/python -B -m zitar_next.gateway --port 8080
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=256M

[Install]
WantedBy=multi-user.target
