[Unit]
Description=Fixed-model fresh-data diagnostic study, no paper promotion
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zitar
Group=zitar
WorkingDirectory=/srv/zitar/runtime
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
ExecStart=/srv/zitar/venv/bin/python -B -m zitar_next.forward_study --root /srv/zitar/data/next --study /srv/zitar/data/next/studies/20261010-v1
Nice=15
CPUQuota=50%
MemoryMax=2G
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/zitar/data/next/studies/20261010-v1

